<Window x:Class="DrekoAccSwitcher.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to Dreko"
        Width="520" Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource AccentBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/Assets/drekoaccswitcher.png" Width="25" Height="25"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="CaptionTitle" Foreground="#0B0F14" FontSize="14"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    </StackPanel>
                    <Button Width="46" Height="42" HorizontalAlignment="Right"
                            Style="{StaticResource CloseWindowCaptionButton}"
                            Click="Close_Click"
                            AutomationProperties.Name="Close"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#0B0F14"
                              StrokeThickness="1.4" HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="34,24,34,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="/Assets/drekoaccswitcher.png" Width="88" Height="88"
                           Stretch="Uniform" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Heading" Margin="0,18,0,0" FontSize="25"
                               FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RightsText" Margin="0,16,0,0" FontSize="17"
                               Foreground="{StaticResource TextBrush}" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VisitPrompt" Margin="0,22,0,6" FontSize="14"
                               Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <TextBlock TextAlignment="Center" FontSize="15">
                        <Hyperlink x:Name="WebsiteLink" NavigateUri="https://dreko8u.web.app"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextDecorations="{x:Null}"
                                   RequestNavigate="WebsiteLink_RequestNavigate"/>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="ContinueButton" Grid.Row="1" Width="148" Height="40"
                        HorizontalAlignment="Center" Margin="0,20,0,0"
                        Style="{StaticResource AccentButton}" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
