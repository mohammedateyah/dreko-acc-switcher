<Window x:Class="DrekoAccSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DrekoAccSwitcher.ViewModels"
        Title="{Binding AppTitle}"
        Icon="/Assets/drekoaccswitcher.png"
        Height="740" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding FlowDirection}"
        Background="{StaticResource BgBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource AccentBrush}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="/Assets/drekoaccswitcher.png" Width="25" Height="25" Stretch="Uniform"/>
                    <TextBlock Text="{Binding AppTitle}" Foreground="#0B0F14" FontSize="14"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowCaptionButton}" Click="Minimize_Click"
                            AutomationProperties.Name="Minimize">
                        <Path Data="M 0,0 L 10,0" Stroke="#0B0F14" StrokeThickness="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource WindowCaptionButton}" Click="MaximizeRestore_Click"
                            AutomationProperties.Name="Maximize or restore">
                        <Grid Width="12" Height="12">
                            <Path x:Name="MaximizeGlyph" Data="M 1,1 L 11,1 11,11 1,11 Z"
                                  Stroke="#0B0F14" StrokeThickness="1.2"/>
                            <Path x:Name="RestoreGlyph" Data="M 3,1 L 11,1 11,9 M 1,3 L 9,3 9,11 1,11 Z"
                                  Stroke="#0B0F14" StrokeThickness="1.2" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseWindowCaptionButton}" Click="Close_Click"
                            AutomationProperties.Name="Close">
                        <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="#0B0F14" StrokeThickness="1.4"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,22,8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/drekoaccswitcher.png" Width="68" Height="68" Stretch="Uniform"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DREKO" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="18"/>
                            <TextBlock Text="ACC SWITCHER" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding LaunchersText}" Margin="0,20,0,10" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Button Content="{Binding SettingsText}" Style="{StaticResource GhostButton}" Click="Settings_Click" Margin="0,0,0,8"/>
                    <Button Content="{Binding OpenDataText}" Style="{StaticResource GhostButton}" Command="{Binding OpenDataCommand}"/>
                </StackPanel>

                <Button DockPanel.Dock="Top" Content="{Binding HomeText}" Style="{StaticResource GhostButton}"
                        Command="{Binding HomeCommand}" Margin="16,0,16,8"/>

                <ListBox ItemsSource="{Binding Platforms}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="12,0"
                         SelectedItem="{Binding SelectedPlatform, Mode=OneWay}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PlatformItem}">
                            <Button Command="{Binding DataContext.SelectPlatformCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" Style="{StaticResource PlatformButton}">
                                <Border CornerRadius="10" Padding="10,9">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected}" Value="True">
                                                    <Setter Property="Background" Value="#1C2736"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#0E141C">
                                            <Image Source="{Binding IconPath}" Width="30" Height="30" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding InstalledText}" FontSize="11" Foreground="{StaticResource MutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Installed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Rectangle Grid.Column="2" Width="3" Height="22" RadiusX="2" RadiusY="2"
                                                   Fill="{Binding Accent}" VerticalAlignment="Center">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="28,22,28,18">
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHome}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" Foreground="{StaticResource TextBrush}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding HeaderHint}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,18,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="{Binding LaunchText}" Style="{StaticResource GhostButton}" Command="{Binding LaunchCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding AddNewText}" Style="{StaticResource GhostButton}" Command="{Binding AddNewCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding SaveAccountText}" Style="{StaticResource AccentButton}" Command="{Binding SaveCurrentCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Margin="0,0,8,0" Style="{StaticResource SearchIconButton}" Command="{Binding SearchCommand}"
                            ToolTip="{Binding SearchText}" AutomationProperties.Name="{Binding SearchText}">
                        <Grid Width="19" Height="19">
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1"
                                     Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                            <Line X1="10" Y1="10" X2="17" Y2="17" Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button>
                    <TextBox x:Name="SearchBox" Width="190" Height="38" FontSize="14"
                         HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Visibility="{Binding SearchBoxVisibility}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding SearchPlaceholder}"
                         Tag="{Binding SearchPlaceholder}"/>
                    <Button Content="{Binding ClearSearchText}" Height="38" Margin="8,0,0,0"
                            Padding="10,0" VerticalAlignment="Center"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchBoxVisibility}"/>
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock Text="{Binding InstalledLabel}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="12" HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <Grid>
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountItem}">
                            <Border Width="250" Height="198" Margin="0,0,14,14" Background="{StaticResource CardBrush}" CornerRadius="14"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.SwitchText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.SwitchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.RenameText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.RenameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.ForgetText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.ForgetCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </Border.Tag>
                                <DockPanel Margin="16">
                                    <Button DockPanel.Dock="Bottom" Content="{Binding DataContext.SwitchText, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource AccentButton}"
                                            Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <StackPanel Orientation="Vertical" DockPanel.Dock="Top"
                                                HorizontalAlignment="Center">
                                        <Grid Width="48" Height="48">
                                            <Border CornerRadius="24" Background="#0E141C">
                                                <TextBlock Text="{Binding Initials}" Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Ellipse>
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                                <Ellipse.Fill>
                                                    <ImageBrush Stretch="UniformToFill">
                                                        <ImageBrush.ImageSource>
                                                            <Binding Path="AvatarPath"/>
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Margin="0,6,0,0" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" Width="210">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}"
                                                       FontFamily="Segoe UI" Language="en-US"
                                                       FlowDirection="{Binding DisplayNameFlowDirection}"
                                                       FontWeight="SemiBold" FontSize="15"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="210"
                                                       TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}"
                                                       FontFamily="Segoe UI" Language="en-US"
                                                       FlowDirection="{Binding SubtitleFlowDirection}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="210" TextAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Margin="0,16,0,10" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Text="{Binding DataContext.RightClickHint, RelativeSource={RelativeSource AncestorType=Window}}"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAccounts}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding NoAccountsText}" Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding EmptyHint}"/>
                </StackPanel>
            </Grid>
        </DockPanel>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHome}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding HomeTitle}" Foreground="{StaticResource TextBrush}"
                               FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="{Binding HomeDescription}" Foreground="{StaticResource MutedBrush}"
                               FontSize="15" Margin="0,8,0,26" TextWrapping="Wrap" MaxWidth="760"/>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                                    <TextBlock Text="i" Foreground="#0B0F14" FontFamily="Segoe UI"
                                               FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding PrivacyNoteTitle}" Foreground="{StaticResource TextBrush}"
                                           FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PrivacyNoteText}" Foreground="{StaticResource MutedBrush}"
                                       FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                                       TextAlignment="{Binding PrivacyNoteTextAlignment}"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,0,0,24">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0"
                                MinHeight="138">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding TotalAccountsText}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" TextAlignment="Center"/>
                                <TextBlock Text="{Binding AccountCountText}" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Segoe UI" FontSize="38" FontWeight="Bold" Margin="0,2,0,2"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Language="en-US" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,0"
                                MinHeight="138">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding AppTitle}" Foreground="{StaticResource TextBrush}"
                                           FontSize="14" Margin="0,0,0,6" TextAlignment="Center"/>
                                <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Segoe UI" FontSize="34" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Language="en-US" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="18" MinHeight="138">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <TextBlock Text="{Binding UpdateStatusTitle}" Foreground="{StaticResource TextBrush}"
                                           FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="{Binding UpdateStatusText}" Foreground="{StaticResource MutedBrush}"
                                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                                <TextBlock Text="{Binding UpdateVersionText}"
                                           Visibility="{Binding UpdateVersionVisibility}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Language="en-US" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{Binding UpdateProgressText}"
                                           Visibility="{Binding UpdateProgressVisibility}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           Language="en-US" FlowDirection="LeftToRight"/>
                                <Button Command="{Binding UpdateCommand}"
                                        Visibility="{Binding UpdateButtonVisibility}"
                                        Style="{StaticResource AccentButton}"
                                        HorizontalAlignment="Center"
                                        Margin="0,12,0,0"
                                        Padding="16,7">
                                    <StackPanel Orientation="Horizontal" FlowDirection="{Binding FlowDirection}">
                                        <TextBlock Text="{Binding UpdateButtonText}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding UpdateProgressText}"
                                                   Visibility="{Binding UpdateProgressVisibility}"
                                                   FlowDirection="LeftToRight"
                                                   Language="en-US"
                                                   FontFamily="Segoe UI"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel>
                            <TextBlock Text="{Binding HowToUseTitle}" Foreground="{StaticResource TextBrush}"
                                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="1." Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI"
                                           FontSize="14" FontWeight="SemiBold" Language="en-US"
                                           FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding HowToUseStepOne}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                                           TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="2." Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI"
                                           FontSize="14" FontWeight="SemiBold" Language="en-US"
                                           FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding HowToUseStepTwo}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                                           TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="3." Foreground="{StaticResource AccentBrush}" FontFamily="Segoe UI"
                                           FontSize="14" FontWeight="SemiBold" Language="en-US"
                                           FlowDirection="LeftToRight" TextAlignment="Center" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding HowToUseStepThree}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                                           TextWrapping="Wrap" TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4"
                    Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    Click="DrekoStudio_Click" AutomationProperties.Name="DrekoStudio website">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Opacity" Value="0.65"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHome}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Image Source="/Assets/drekoaccswitcher.png" Width="20" Height="20"
                           Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.78"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="DrekoStudio©" FontFamily="Segoe UI" FontSize="12" Language="en-US"
                               FlowDirection="LeftToRight" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                 Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
